    <%@ Master Language="C#" AutoEventWireup="true" CodeFile="MasterPage.master.cs" Inherits="MasterPage" %>

<!DOCTYPE html>

<html>
<head runat="server">
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>
        <asp:ContentPlaceHolder ID="tab" runat="server"></asp:ContentPlaceHolder>
    </title>
    <link rel="icon" type="image/x-icon" href="Images/Notification%20Happy.png" />
    <link href="Styles/StyleSheet.css" rel="stylesheet">
    <script src="Scripts/JavaScript.js" defer></script>
</head>
<body>
    <form id="form1" runat="server">
    <div id="page" class="page-wrapper">
        <header>
            <asp:ContentPlaceHolder ID="headerContentPlaceHolder" runat="server"></asp:ContentPlaceHolder>
        </header>

        <div class="main-content" id="mainContentDiv">
            <nav>
                <asp:ContentPlaceHolder ID="navContent" runat="server"></asp:ContentPlaceHolder>
            </nav>

            <asp:ContentPlaceHolder ID="mainContentPlaceHolder" runat="server"></asp:ContentPlaceHolder>
        </div>

        <footer>
            <asp:ContentPlaceHolder ID="footerContentPlaceHolder" runat="server"></asp:ContentPlaceHolder>
            <p>© 2025 StudyPaws. All rights reserved.</p>
        </footer>

        <div class="wave-section">
            <div class="wave-layer"></div>
        </div>
    </div>
</form>
</body>
</html>